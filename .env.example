# ─────────────────────────────────────────────────────────────
#  PizzaHub server (Express API) — environment variables
#  Copy this file to ".env" and fill in your own values.
#  Never commit the real ".env" file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
PORT=5000
# "production" hides internal error details in API responses
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# Same MongoDB as the client (database "pizzaPulse")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Client / auth ────────────────────────────────────────────
# Address of the Next.js client (Better Auth). Used to:
#  - download the public keys (JWKS) that verify JWT tokens: <AUTH_URL>/api/auth/jwks
#  - check the token issuer and audience
#  - build the Stripe success / cancel return links
# Must match the client's BETTER_AUTH_URL. Production: https://your-client-domain.com
AUTH_URL=http://localhost:3000

# Address of the client allowed by CORS. Production: https://your-client-domain.com
CLIENT_URL=http://localhost:3000

# ── Stripe (vendor subscriptions only) ───────────────────────
# Secret key (sk_test_... in test mode). Never put it in the client.
STRIPE_SECRET_KEY=
