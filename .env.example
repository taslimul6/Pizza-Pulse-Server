PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/?ssl=true&replicaSet=<rs>&authSource=admin
MONGODB_DB=pizzapulse

# Address of the Next.js app (Better Auth). Used to download the public keys that verify JWT tokens.
AUTH_URL=http://localhost:3000

# Stripe secret key (test mode: sk_test_...). Used only for vendor subscriptions.
STRIPE_SECRET_KEY=
